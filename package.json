{
  "name": "code-ally",
  "version": "0.3.0",
  "description": "AI pair programming assistant with Ink UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benhmoore/Code-Ally.git"
  },
  "type": "module",
  "bin": {
    "ally": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias && node scripts/copy-agents.js && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "watch": "tsc --watch",
    "test": "vitest --run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "ai",
    "cli",
    "assistant",
    "ollama",
    "terminal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@vscode/ripgrep": "^1.15.9",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "commander": "^14.0.1",
    "diff": "^8.0.2",
    "fast-glob": "^3.3.2",
    "ink": "^4.4.1",
    "marked": "^16.4.1",
    "openai": "^7.4.0",
    "react": "^18.2.0",
    "sharp": "^0.35.3",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.2.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
