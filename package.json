{
  "name": "code-ally",
  "version": "0.3.0",
  "description": "AI pair programming assistant with Ink UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benhmoore/Code-Ally.git"
  },
  "type": "module",
  "bin": {
    "ally": "./dist/cli.js",
    "ally-lab": "./scripts/ally-lab.sh"
  },
  "files": [
    "dist",
    "scripts/ally-lab.sh",
    "scripts/ally-lab-session.py"
  ],
  "scripts": {
    "build": "tsc && tsc-alias && node scripts/copy-agents.js && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "watch": "tsc --watch",
    "test": "vitest --run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "eval:models": "tsx src/evals/modelCompatibility.ts",
    "eval:harness": "tsx src/evals/harnessAblation.ts",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "ai",
    "cli",
    "assistant",
    "ollama",
    "terminal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/ripgrep": "^1.18.0",
    "chalk": "^6.0.0",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.2",
    "fs-native-extensions": "^1.5.1",
    "ink": "github:vadimdemedes/ink#06385e9",
    "marked": "^18.0.13",
    "openai": "^7.20.0",
    "react": "^19.3.0",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
